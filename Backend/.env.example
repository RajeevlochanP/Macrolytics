# POSTGRES CONFIGURATION
# Database host
DB_HOST=localhost
# Database port
DB_PORT=5432
# Database user
DB_USER=postgres
# Database password
DB_PASSWORD=password
# Database name
DB_NAME=calorie_tracker

# REDIS CONFIGURATION
# Redis connection URL for rate limiting, caching, and BullMQ
REDIS_URL=redis://127.0.0.1:6379

# AWS S3 CONFIGURATION
# AWS region for S3 bucket
AWS_REGION=us-east-1
# AWS access key ID
AWS_ACCESS_KEY_ID=your_access_key
# AWS secret access key
AWS_SECRET_ACCESS_KEY=your_secret_key
# Name of the S3 bucket for uploads
S3_BUCKET_NAME=calorie-tracker-uploads

# GEMINI LLM CONFIGURATION
# Google Gemini API Key for vision and agent capabilities
GEMINI_API_KEY=your_gemini_api_key

# EXPRESS SERVER CONFIGURATION
# Port for the Node.js server to listen on
PORT=3000
